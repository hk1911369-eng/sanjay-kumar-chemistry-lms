# Required public Supabase project settings (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Canonical public origin used to construct Auth confirmation and recovery URLs
APP_URL=http://localhost:3000

# No online wallet gateway credentials are used in this manual-payment release.
# Receiving bKash / Nagad / Rocket numbers are configured in the Admin dashboard
# after independently verifying ownership. They are stored in the private database table.
